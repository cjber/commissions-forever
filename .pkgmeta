package-as: CommissionsForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - AGENTS.md
  - tools
  - types
  - tests
  - docs
  - ruff.toml
  - stylua.toml
  - .agents
  - forever-core
  - media/icon.svg
  - media/icon-400.png

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - questiedb
  - skillup-forever
  - shortest-path-forever

# ForeverCore ships inside this zip as its own folder, at the release tools/forever-core.txt pins, so an
# update brings it along: players who updated did not get it as a required dependency, and Wago's uploads
# carry no dependencies at all.
externals:
  ForeverCore: https://github.com/cjber/forever-core/releases/download/v1.7.3/ForeverCore-v1.7.3-forever.zip

move-folders:
  CommissionsForever/ForeverCore: ForeverCore
