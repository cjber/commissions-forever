package-as: CommissionsForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - AGENTS.md
  - tools
  - types
  - tests
  - docs
  - ruff.toml
  - stylua.toml
  - .agents
  - forever-core
  - media/icon.svg
  - media/icon-400.png

required-dependencies:
  - forevercore
