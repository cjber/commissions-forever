package-as: CommissionsForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - AGENTS.md
  - tools
  - types
  - tests
  - docs
  - ruff.toml
  - stylua.toml
  - .agents
  - forever-core
  - media/icon.svg
  - media/icon-400.png

# ForeverCore has no CurseForge project (it ships from GitHub and Wago), so it cannot be a
# CurseForge relation; the TOC's `## Dependencies: ForeverCore` is what the client reads.

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - questiedb
  - skillup-forever
  - shortest-path-forever
