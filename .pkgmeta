package-as: CommissionsForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - AGENTS.md
  - tools
  - types
  - tests
  - docs
  - ruff.toml
  - stylua.toml
  - .agents
  - forever-core
  - media/icon.svg
  - media/icon-400.png

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - questiedb
  - skillup-forever
  - shortest-path-forever

# ForeverCore is embedded under Libs/ForeverCore, so it is listed as an embedded library: the CurseForge app links
# it on the project page but never installs it as a required dependency.
embedded-libraries:
  - forevercore
